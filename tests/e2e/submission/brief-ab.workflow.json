       "handler": "__function__:code_exec",
       "parameters": {
        "type": "object",
        "properties": {
         "code": {
          "type": "string",
          "default": "try:\n    vars['route'] = 'stale'\n    if str(vars.get('w_go_verify_identity') or '') != 'go':\n        vars['w_go_verify_identity'] = 'done'\n    if str(vars.get('w_go_get_account') or '') != 'go':\n        vars['w_go_get_account'] = 'done'\n    if str(vars.get('w_go_create_promise') or '') != 'go':\n        vars['w_go_create_promise'] = 'done'\n    if str(vars.get('w_go_add_note') or '') != 'go':\n        vars['w_go_add_note'] = 'done'\n    if str(vars.get('w_go_schedule_callback') or '') != 'go':\n        vars['w_go_schedule_callback'] = 'done'\n    if str(vars.get('w_go_transfer_to_agent') or '') != 'go':\n        vars['w_go_transfer_to_agent'] = 'done'\nexcept Exception:\n    vars['route'] = 'stale'\n"
         },
         "timeout_ms": {
          "type": "number",
          "default": 10000
         }
        }
       }
      }
     }
    ],
    "transitions": [
     {
      "target_node": "hub",
      "description": "always",
      "condition": {
       "operator": "always"
      }
     }
    ]
   },
