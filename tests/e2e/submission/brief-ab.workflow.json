   "hub": {
    "name": "hub",
    "node_type": "code",
    "passthrough": true,
    "passthrough_default_transition": "talk_pre",
    "on_enter": {
     "type": "silent"
    },
    "pre_actions": [
     {
      "type": "function",
      "function": {
       "name": "code_exec",
       "handler": "__function__:code_exec",
       "parameters": {
        "type": "object",
        "properties": {
         "code": {
          "type": "string",
          "default": "import datetime\ntry:\n    vars['say_next'] = \"Sorry, could you say that again?\"\n    vars['route'] = 'say'\n    t = datetime.datetime.now().strftime('%f%S%M')\n    vars['ev_tok'] = ''.join('abcdefghijklmnopqrstuvwxyz'[(int(c) * 7 + i * 3) % 26] for i, c in enumerate(t[:6]))\nexcept Exception:\n    vars['route'] = 'talk_pre'\n"
         },
         "timeout_ms": {
          "type": "number",
          "default": 10000
         }
        }
       }
      }
     }
    ],
    "transitions": [
     {
      "target_node": "close_say",
      "description": "close",
      "condition": {
       "logic": "or",
       "conditions": [
        {
         "variable": "route",
