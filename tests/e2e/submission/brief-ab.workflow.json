 "workflow": {
  "initial_node": "greet",
  "system_prompt": "You are the Freya Bank's digital assistant; the call is recorded of Freya Bank. Speak en, one or two short sentences per turn. Never say that anything was recorded, scheduled or transferred. Never invent figures, dates or reasons.",
  "nodes": {
   "greet": {
    "name": "greet",
    "node_type": "conversation",
    "on_enter": {
     "type": "tts",
     "text": "Hello, this is the Freya Bank's digital assistant; the call is recorded of Freya Bank."
    },
    "task_message": "No tool call is allowed. Wait for the customer.",
    "extraction_schema": [
     {
      "name": "ev",
      "type": "string",
      "min_confidence": 0.3,
      "max_retries": 2,
      "validation_pattern": "^n=[a-z]{6};src=user;kind=[a-z_]+;also=[a-z_]+;st=(complete|partial|ambiguous|none);prod=[a-z0-9]*(;[a-z_]+=[^;=]*)*$",
      "description": "The customer's last message as one event code (contract \u00a71)",
      "extraction_prompt": "Code: {{ev_tok}}\nLabel only the customer's last message as one event string: n=<the code>;src=user;kind=<kind>;also=<kind or none>;st=<complete|partial|ambiguous|none>;prod=<n or all or empty>. The value is a code label, never the customer's words.\n{{extractor.type_preamble}}\n{{extractor.variables_list}}\nConversation:\n{{extractor.conversation.last-10}}\nLast message: {{extractor.speech}}"
     }
    ],
    "max_node_turns": 80,
    "transitions": [
     {
      "target_node": "hub_reset",
      "description": "always",
      "condition": {
       "operator": "always"
      }
     }
    ]
   },
   "hub_reset": {
    "name": "hub_reset",
