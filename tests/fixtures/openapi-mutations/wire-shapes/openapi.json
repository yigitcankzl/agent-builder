{
  "openapi": "3.0.3",
  "info": {
    "title": "Collections tools (wire-shapes)",
    "version": "0.3-mutation",
    "description": "Verified is a string status. Products have no type. Amounts are pence. Callback is one datetime. Schemas are components."
  },
  "servers": [
    {
      "url": "https://freya-bank-mock.freyavoice.workers.dev/v1"
    }
  ],
  "components": {
    "schemas": {
      "verify_identity_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "enum": [
              "date_of_birth",
              "phone_last4"
            ]
          },
          "answer": {
            "type": "string",
            "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits."
          }
        },
        "required": [
          "customer_id",
          "field",
          "answer"
        ]
      },
      "verify_identity_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "wrong_answers_left": {
            "type": "integer"
          },
          "all_verified": {
            "type": "boolean"
          },
          "hint": {
            "type": "string",
            "enum": [
              "day_month_swapped"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "failed"
            ],
            "description": "verified when the answer matched. failed when it did not."
          }
        }
      },
      "get_account_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          }
        },
        "required": [
          "customer_id"
        ]
      },
      "get_account_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string"
                },
                "card_last4": {
                  "type": "string",
                  "description": "credit cards only"
                },
                "past_due": {
                  "type": "integer",
                  "description": "Minor units, pence. 54000 is 540.00."
                },
                "days_late": {
                  "type": "integer"
                },
                "minimum_payment": {
                  "type": "integer",
                  "description": "Minor units, pence. 54000 is 540.00."
                },
                "instalment_amount": {
                  "type": "integer",
                  "description": "Minor units, pence. 54000 is 540.00."
                }
              }
            }
          }
        }
      },
      "create_promise_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "description": "Minor units, pence. 54000 is 540.00."
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "customer_id",
          "product_id",
          "amount",
          "date"
        ]
      },
      "create_promise_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "promise_id": {
            "type": "string"
          }
        }
      },
      "add_note_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "refused",
              "hardship",
              "dispute",
              "paid",
              "service_error"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "customer_id",
          "product_id",
          "reason"
        ]
      },
      "add_note_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "schedule_callback_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "format": "date-time",
            "description": "Callback date and time in one value, ISO-8601."
          }
        },
        "required": [
          "customer_id",
          "when"
        ]
      },
      "schedule_callback_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "transfer_to_agent_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "queue": {
            "type": "string",
            "enum": [
              "restructuring",
              "general",
              "support"
            ]
          }
        },
        "required": [
          "customer_id",
          "queue"
        ]
      },
      "transfer_to_agent_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "close_call_body": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "promise",
              "paid",
              "transferred",
              "no_promise",
              "not_verified",
              "not_reached"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Required for every outcome except promise and paid. See the table in the brief."
          }
        },
        "required": [
          "customer_id",
          "outcome"
        ]
      },
      "close_call_result": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/verify_identity": {
      "post": {
        "summary": "Check one security answer. Three wrong answers in total end the check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/verify_identity_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/verify_identity_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/get_account": {
      "post": {
        "summary": "The late products. Refused until both questions are passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/get_account_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/get_account_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/create_promise": {
      "post": {
        "summary": "Record a payment promise. One per product.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/create_promise_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/create_promise_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/add_note": {
      "post": {
        "summary": "Brief B: record why a product ended without a promise.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/add_note_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/add_note_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/schedule_callback": {
      "post": {
        "summary": "Book a callback.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/schedule_callback_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/schedule_callback_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/transfer_to_agent": {
      "post": {
        "summary": "Hand the call to a person.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/transfer_to_agent_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/transfer_to_agent_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    },
    "/close_call": {
      "post": {
        "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/close_call_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ok` is false when the action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/close_call_result"
                }
              }
            }
          },
          "500": {
            "description": "The service failed. Nothing was recorded. The call may be repeated."
          }
        }
      }
    }
  }
}
