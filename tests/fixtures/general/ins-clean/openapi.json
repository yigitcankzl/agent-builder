{
  "openapi": "3.0.3",
  "info": {
    "title": "Northwind Cover premium tools",
    "version": "1.0.0",
    "description": "Local contract for overdue-premium collection. Not the Freya bank mock. The service records what it is sent. Following the brief is the caller's job."
  },
  "paths": {
    "/verify_identity": {
      "post": {
        "summary": "Check one security answer. Two wrong answers in total end the check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {"type": "string"},
                  "field": {
                    "type": "string",
                    "enum": ["policy_number_last4", "postcode"]
                  },
                  "answer": {
                    "type": "string",
                    "description": "policy_number_last4: four digits. postcode: uppercase with one space before the inward code."
                  }
                },
                "required": ["customer_id", "field", "answer"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok is false when the answer could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "verified": {"type": "boolean"},
                    "wrong_answers_left": {"type": "integer"},
                    "all_verified": {"type": "boolean"}
                  }
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    },
    "/get_account": {
      "post": {
        "summary": "The overdue premium. Refused until both questions are passed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {"customer_id": {"type": "string"}},
                "required": ["customer_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One overdue cover.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "policy_id": {"type": "string"},
                          "type": {
                            "type": "string",
                            "enum": ["home_policy", "motor_policy", "travel_policy"]
                          },
                          "premium_due": {"type": "number"},
                          "days_overdue": {"type": "integer"},
                          "monthly_premium": {"type": "number"}
                        },
                        "required": ["policy_id", "type", "premium_due", "days_overdue", "monthly_premium"]
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    },
    "/create_promise": {
      "post": {
        "summary": "Save one premium arrangement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {"type": "string"},
                  "policy_id": {"type": "string"},
                  "premium": {"type": "number"},
                  "due_on": {"type": "string", "format": "date"}
                },
                "required": ["customer_id", "policy_id", "premium", "due_on"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok is true when the arrangement was saved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {"type": "boolean"},
                    "arrangement_id": {"type": "string"}
                  }
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    },
    "/add_note": {
      "post": {
        "summary": "Not used by this desk. Present so the tool name still exists.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {"type": "string"},
                  "policy_id": {"type": "string"},
                  "reason": {
                    "type": "string",
                    "enum": ["refused_plan", "hardship_noted", "cover_dispute", "already_settled", "service_error"]
                  }
                },
                "required": ["customer_id", "policy_id", "reason"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok is true when the note was stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"ok": {"type": "boolean"}}
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    },
    "/schedule_callback": {
      "post": {
        "summary": "Book a callback.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {"type": "string"},
                  "date": {"type": "string", "format": "date"},
                  "time": {"type": "string", "description": "HH:MM"}
                },
                "required": ["customer_id", "date", "time"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok is true when the callback was booked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"ok": {"type": "boolean"}}
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    },
    "/transfer_to_agent": {
      "post": {
        "summary": "Hand the call to a person.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {"type": "string"},
                  "queue": {
                    "type": "string",
                    "enum": ["care", "collector", "switchboard"]
                  }
                },
                "required": ["customer_id", "queue"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok is true when the transfer was accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"ok": {"type": "boolean"}}
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    },
    "/close_call": {
      "post": {
        "summary": "End the call. Always the last tool call.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {"type": "string"},
                  "outcome": {
                    "type": "string",
                    "enum": ["arrangement", "settled", "handed_off", "no_arrangement", "not_confirmed", "no_contact"]
                  },
                  "reason": {
                    "type": "string",
                    "enum": ["care", "collector", "refused_plan", "hardship_noted", "cover_dispute", "service_error", "failed_id", "declined_id", "callback", "no_callback", "wrong_line", "deceased", "unclear"]
                  }
                },
                "required": ["customer_id", "outcome"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok is true when the call was closed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"ok": {"type": "boolean"}}
                }
              }
            }
          },
          "500": {"description": "The service failed. The call may be repeated."}
        }
      }
    }
  }
}
