 "multi_product": {
  "applies": true,
  "state_all_first": true,
  "ask_all_today_once": true,
  "one_date_clamp": true,
  "one_readback": true,
  "source": [
   {
    "file": "policy-extract.md",
    "quote": "State every late product, then ask whether they can pay all of them today."
   },
   {
    "file": "policy-extract.md",
    "quote": "If they name one date for every product, do not start the per-product plan."
   },
   {
    "file": "policy-extract.md",
    "quote": "The others keep the named date, after the business-day move."
   },
   {
    "file": "policy-extract.md",
    "quote": "Each later product starts at step 1."
   },
   {
    "file": "policy-extract.md",
    "quote": "A date they name for the current product is accepted when it is a business day on or before that product's deadline."
   },
   {
    "file": "policy-extract.md",
    "quote": "It does not use an attempt."
   },
   {
    "file": "policy-extract.md",
    "quote": "Read every promise back together and ask \"Do you confirm?\" once."
   },
   {
    "file": "policy-extract.md",
    "quote": "Then `create_promise` once per product, with `customer_id`, `product_id`, `amount` and `date`."
   }
  ]
 },
