    "file": "brief.md",
    "quote": "| 1 to 10 | early | the 12th business day after today | 1 | minimum_payment or instalment_amount |"
   },
   {
    "file": "brief.md",
    "quote": "| 11 to 40 | late | the 7th business day after today | 2 | minimum_payment or instalment_amount |"
   },
   {
    "file": "brief.md",
    "quote": "The early deadline is the 5th business day after today."
   },
   {
    "file": "brief.md",
    "quote": "The late deadline is the 3rd business day after today."
   },
   {
    "file": "brief.md",
