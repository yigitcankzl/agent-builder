    "file": "brief.md",
    "quote": "Take them in the order get_account returned them."
   },
   {
    "file": "brief.md",
    "quote": "A credit card's floor is 40 percent of past_due, rounded half up to the penny."
   },
   {
    "file": "brief.md",
    "quote": "Three hundred on a card has a floor of 120."
   },
   {
    "file": "brief.md",
    "quote": "A personal loan's floor is 25 percent of past_due, rounded half up to the penny."
   },
   {
    "file": "brief.md",
    "quote": "Nine hundred on a personal loan has a floor of 225."
   },
   {
    "file": "brief.md",
    "quote": "Thirteen twenty on a personal loan has a floor of 330."
   },
   {
    "file": "brief.md",
    "quote": "Do not put the card's 40 percent on a loan."
   },
   {
    "file": "brief.md",
    "quote": "The minimum and the instalment are not the floor."
   },
   {
    "file": "brief.md",
    "quote": "There is no car floor and no note on the car."
   }
  ]
