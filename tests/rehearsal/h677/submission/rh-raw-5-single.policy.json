  },
  "pre_verification_queues": [],
  "source": [
   {
    "file": "default",
    "quote": ""
   },
   {
    "file": "brief.md",
    "quote": "Car loans are the exception."
   },
   {
    "file": "brief.md",
    "quote": "We do not promise a car loan."
   },
   {
    "file": "brief.md",
    "quote": "Transfer every car loan to the new_plan queue."
   },
   {
    "file": "brief.md",
    "quote": "That transfer is instead of a promise."
   },
   {
    "file": "brief.md",
    "quote": "Then create_promise once per product you are promising."
   },
   {
    "file": "brief.md",
    "quote": "A product with no promise and no transfer gets a note."
   },
   {
    "file": "brief.md",
    "quote": "The office word for a refusal is will_not_pay."
   },
   {
    "file": "brief.md",
    "quote": "Write that note even when another product is transferred."
   },
   {
    "file": "brief.md",
    "quote": "The car transfer does not erase it."
   },
   {
    "file": "brief.md",
    "quote": "Do not write a note on the car."
   },
   {
    "file": "brief.md",
    "quote": "Save the promises, then write the refused notes, then transfer the car if there is one, then close."
   }
  ]
 },
